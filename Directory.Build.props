<Project>

  <!-- The language and the analyzers: every warning fails the build. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <!--
    The build reports an unused using (IDE0005) only when the compiler writes the documentation file. That file
    brings CS1591, a warning for every public member without a comment, which is not a rule here.
  -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- A project sees only the projects it references itself, so the references in the project files are the graph. -->
  <PropertyGroup>
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <!--
    Build and publish output of every project goes to artifacts/, beside this file. The path is set here because
    UseArtifactsOutput alone follows the nearest Directory.Build.props: tests would write to tests/artifacts.
  -->
  <PropertyGroup>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
  </PropertyGroup>

  <!--
    Packages: each project commits a lock file. A package with a known vulnerability stays a warning, so that an
    advisory published later does not break the build of an unchanged commit. Only a restore that sets
    AuditPipeline, as the audit job of continuous integration does, turns the audit warnings into errors.
  -->
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAuditCodes>NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</NuGetAuditCodes>
    <WarningsAsErrors Condition="'$(AuditPipeline)' == 'true'">$(WarningsAsErrors);$(NuGetAuditCodes)</WarningsAsErrors>
    <WarningsNotAsErrors Condition="'$(AuditPipeline)' != 'true'">$(WarningsNotAsErrors);$(NuGetAuditCodes)</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- On GitHub Actions the restore fails when a lock file is out of date, and the build is deterministic. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <RestoreLockedMode>true</RestoreLockedMode>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    The analyzer options of every project. The file is passed by name: one called .globalconfig is also read from
    every folder above a project, so a worktree inside another checkout would get two of them.
  -->
  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)CodeAnalysis.globalconfig" />
  </ItemGroup>

  <!-- The symbols that no project may use, read by the analyzer that Directory.Packages.props adds everywhere. -->
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

</Project>
