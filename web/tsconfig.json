{
  "compilerOptions": {
    "module": "es2020",
    "target": "es2020",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "alwaysStrict": true
  },
  "include": [
    "**/*.ts"
  ],
  // The tests of the window run in Node.js, not in the page: window-tests/tsconfig.json checks them
  "exclude": [
    "node_modules",
    "window-tests",
    "playwright.config.ts"
  ]
}
