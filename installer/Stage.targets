<Project>

  <!--
    The application as a package installs it, laid out in one folder for each runtime:

    - the application published for win-x64, with the identity of a release;
    - wwwroot: the static files of web/wwwroot and the release bundle of artifacts/web.

    Bravo.Setup.exe, the program that a package runs, is published in a folder of its own: a package carries
    it in itself and does not install it.

    The build never runs npm: the bundle is there after "npm ci" and "npm run build:Release" in web/.
  -->

  <PropertyGroup>
    <StagePublishArguments>-c Release -r win-x64 -warnaserror</StagePublishArguments>
    <StagePublishArguments Condition="'$(PublicRelease)' != ''">$(StagePublishArguments) -p:PublicRelease=$(PublicRelease)</StagePublishArguments>
  </PropertyGroup>

  <!--
    The application is restored once, as its lock file says, and published without another restore:
    Bravo.Desktop declares the runtime, so the lock file holds the packages of these publishes.

    What the publish leaves out of the folder, because nothing reads it at run time: the documentation files
    of the assemblies, the texts of System.CommandLine in other languages, and the second copy of the loader
    of WebView2, which the process finds beside the executable. Each runtime is built in folders of its own.
  -->
  <PropertyGroup>
    <ApplicationPublishArguments>--no-restore --self-contained $(BravoSelfContained) -p:ArtifactsPivots=package_$(RuntimeName) -p:BravoReleaseBuild=true -p:PublishDocumentationFiles=false -p:SatelliteResourceLanguages=en -p:WebView2NeverCopyLoaderDllToOutputDirectory=true</ApplicationPublishArguments>
  </PropertyGroup>

  <!--
    The program is compiled ahead of time by packages that the .NET SDK adds in its own version, which a lock
    file would hold for one patch of the SDK alone: its restore reads and writes no lock file. The program
    has no other package.
  -->
  <PropertyGroup>
    <SetupRestoreArguments>-p:RestorePackagesWithLockFile=false -p:RestoreLockedMode=false "-p:NuGetLockFilePath=$(StageRoot)none.lock.json"</SetupRestoreArguments>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BravoSetupNativeAot)' == 'true'">
    <SetupKind>aot</SetupKind>
    <SetupPublishArguments>-p:PublishAot=true</SetupPublishArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BravoSetupNativeAot)' != 'true'">
    <SetupKind>singlefile</SetupKind>
    <SetupPublishArguments>--self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -p:EnableCompressionInSingleFile=true</SetupPublishArguments>
  </PropertyGroup>

  <PropertyGroup>
    <DotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotNetHost>
    <DotNetHost Condition="'$(DotNetHost)' == ''">dotnet</DotNetHost>
    <SetupPublishDir>$(StageRoot)setup-$(SetupKind)\</SetupPublishDir>
    <SetupStamp>$(StageRoot)setup-$(SetupKind).published</SetupStamp>
    <SetupInputList>$(StageRoot)setup-$(SetupKind).inputs</SetupInputList>
    <StageStamp>$(StageRoot)$(RuntimeName).staged</StageStamp>
    <StageInputList>$(StageRoot)$(RuntimeName).inputs</StageInputList>
  </PropertyGroup>

  <!--
    The two packages of one runtime, per machine and per user, hold the same files: the cabinet that the first
    one compresses is kept here, and the second one takes it as it is.
  -->
  <PropertyGroup>
    <CabinetCachePath>$(StageRoot)$(RuntimeName)-cabinets\</CabinetCachePath>
  </PropertyGroup>

  <!--
    A release signs the files of the host before a package holds them, and each package after it is built:
    BravoSigning says with which certificate, and Sign-Files.ps1 what each value needs. Without it nothing is
    signed.
  -->
  <PropertyGroup>
    <SignCommand>pwsh -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)Sign-Files.ps1&quot; -Signing $(BravoSigning)</SignCommand>
  </PropertyGroup>

  <!-- A change of any of these publishes the program, or lays the application out, again. -->
  <ItemGroup>
    <BuildRuleFile Include="$(RepositoryRoot)Directory.Build.props;$(RepositoryRoot)Directory.Build.targets;$(RepositoryRoot)Directory.Packages.props" />
    <BuildRuleFile Include="$(MSBuildThisFileFullPath);$(MSBuildProjectFullPath);$(MSBuildThisFileDirectory)Sign-Files.ps1" />
    <SetupInput Include="$(RepositoryRoot)src\Bravo.Setup\**" />
    <SetupInput Include="@(BuildRuleFile)" />
    <WebStaticFile Include="$(RepositoryRoot)web\wwwroot\**" Exclude="$(RepositoryRoot)web\wwwroot\js\**;$(RepositoryRoot)web\wwwroot\css\**" />
    <WebBundleFile Include="$(WebBundleDir)**" />
    <StageInput Include="$(RepositoryRoot)src\**" Exclude="$(RepositoryRoot)src\Bravo.Setup\**" />
    <StageInput Include="@(BuildRuleFile);@(WebStaticFile);@(WebBundleFile)" />
  </ItemGroup>

  <!--
    A file that was deleted is newer than nothing, and the application has the version and the commit of its
    build in itself. The names of the inputs are kept in a file with what was asked of the build, written
    again only when it changes, which is an input as well: a file that left, one that came with an old date,
    another commit or another signature lays the application out again. The program is published again for
    its files and for its signature alone: nothing reads its version.
  -->
  <Target Name="WriteStageInputLists" DependsOnTargets="GetBuildVersion" BeforeTargets="PublishSetupProgram;StageApplication">
    <Error Condition="'$(BravoVersion)' == ''"
           Text="Build with one of the targets BuildPackage, BuildPackages or BuildRelease: they give the build its version." />
    <WriteLinesToFile File="$(SetupInputList)" Lines="signing=$(BravoSigning);@(SetupInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(StageInputList)" Lines="version=$(BravoVersion);commit=$(GitCommitId);signing=$(BravoSigning);@(StageInput)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="PublishSetupProgram" BeforeTargets="BeforeBuild" Inputs="@(SetupInput);$(SetupInputList)" Outputs="$(SetupStamp)">
    <RemoveDir Directories="$(SetupPublishDir)" />
    <Exec Command="&quot;$(DotNetHost)&quot; publish &quot;$(RepositoryRoot)src\Bravo.Setup\Bravo.Setup.csproj&quot; $(StagePublishArguments) $(SetupRestoreArguments) $(SetupPublishArguments) -o &quot;$(SetupPublishDir.TrimEnd('\'))&quot;" />
    <Exec Condition="'$(BravoSigning)' != ''" Command="$(SignCommand) &quot;$(SetupPublishDir)Bravo.Setup.exe&quot;" />
    <Touch Files="$(SetupStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="StageApplication" BeforeTargets="BeforeBuild" Inputs="@(StageInput);$(StageInputList)" Outputs="$(StageStamp)">
    <Error Condition="!Exists('$(WebBundleDir)js\main.js') Or !Exists('$(WebBundleDir)css\main.css')"
           Text="The release bundle of the user interface is not in $(WebBundleDir). In web/, run &quot;npm ci&quot; and &quot;npm run build:Release&quot;." />

    <RemoveDir Directories="$(StageDir);$(CabinetCachePath)" />
    <Exec Command="&quot;$(DotNetHost)&quot; restore &quot;$(RepositoryRoot)src\Bravo.Desktop\Bravo.Desktop.csproj&quot;" />
    <Exec Command="&quot;$(DotNetHost)&quot; publish &quot;$(RepositoryRoot)src\Bravo.Desktop\Bravo.Desktop.csproj&quot; $(StagePublishArguments) $(ApplicationPublishArguments) -o &quot;$(StageDir.TrimEnd('\'))&quot;" />

    <Copy SourceFiles="@(WebStaticFile)" DestinationFiles="@(WebStaticFile->'$(StageDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(WebBundleFile)" DestinationFiles="@(WebBundleFile->'$(StageDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />

    <!-- The executable and the assemblies of the host, by their name: the other files are not of this build. -->
    <ItemGroup>
      <HostFileToSign Include="$(StageDir)Bravo.exe;$(StageDir)Bravo*.dll" />
    </ItemGroup>
    <Exec Condition="'$(BravoSigning)' != ''" Command="$(SignCommand) @(HostFileToSign->'&quot;%(FullPath)&quot;', ' ')" />

    <Touch Files="$(StageStamp)" AlwaysCreate="true" />
  </Target>

  <!-- The folder of the application as an archive: what an installed 1.0.x that was unpacked from one asks for. -->
  <Target Name="ArchiveApplication" DependsOnTargets="StageApplication" Inputs="$(StageStamp)" Outputs="$(ArchivePath)">
    <MakeDir Directories="$(PackageOutputDir)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(ArchivePath)" Overwrite="true" />
  </Target>

</Project>
