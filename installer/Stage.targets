<Project>

  <!--
    The application as a package installs it, laid out in one folder for each runtime:

    - the application published for win-x64, with the identity of a release;
    - wwwroot: the static files of web/wwwroot and the release bundle of artifacts/web.

    Bravo.Setup.exe, the program that a package runs, is published in a folder of its own: a package carries
    it in itself and does not install it.

    The build never runs npm: the bundle is there after "npm ci" and "npm run build:Release" in web/.
  -->

  <!--
    A publish for one runtime restores another graph of packages than the one in the lock files, and would
    write it there. These restores read and write no lock file: the committed ones stay as they are. How a
    release locks that graph is backlog D-02.
  -->
  <PropertyGroup>
    <StageRestoreArguments>-p:RestorePackagesWithLockFile=false -p:RestoreLockedMode=false "-p:NuGetLockFilePath=$(StageRoot)none.lock.json"</StageRestoreArguments>
    <StagePublishArguments>-c Release -r win-x64 -p:Version=$(BravoVersion) -warnaserror $(StageRestoreArguments)</StagePublishArguments>
  </PropertyGroup>

  <!--
    What the publish leaves out of the folder, because nothing reads it at run time: the documentation files
    of the assemblies, the texts of System.CommandLine in other languages, and the second copy of the loader
    of WebView2, which the process finds beside the executable. Each runtime is built in folders of its own.
  -->
  <PropertyGroup>
    <ApplicationPublishArguments>--self-contained $(BravoSelfContained) -p:ArtifactsPivots=package_$(RuntimeName) -p:BravoReleaseBuild=true -p:PublishDocumentationFiles=false -p:SatelliteResourceLanguages=en -p:WebView2NeverCopyLoaderDllToOutputDirectory=true</ApplicationPublishArguments>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BravoSetupNativeAot)' == 'true'">
    <SetupKind>aot</SetupKind>
    <SetupPublishArguments>-p:PublishAot=true</SetupPublishArguments>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BravoSetupNativeAot)' != 'true'">
    <SetupKind>singlefile</SetupKind>
    <SetupPublishArguments>--self-contained true -p:PublishSingleFile=true -p:PublishTrimmed=true -p:EnableCompressionInSingleFile=true</SetupPublishArguments>
  </PropertyGroup>

  <PropertyGroup>
    <DotNetHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</DotNetHost>
    <DotNetHost Condition="'$(DotNetHost)' == ''">dotnet</DotNetHost>
    <SetupPublishDir>$(StageRoot)setup-$(SetupKind)\</SetupPublishDir>
    <SetupStamp>$(StageRoot)setup-$(SetupKind).published</SetupStamp>
    <StageStamp>$(StageRoot)$(RuntimeName).staged</StageStamp>
  </PropertyGroup>

  <!--
    The two packages of one runtime, per machine and per user, hold the same files: the cabinet that the first
    one compresses is kept here, and the second one takes it as it is.
  -->
  <PropertyGroup>
    <CabinetCachePath>$(StageRoot)$(RuntimeName)-cabinets\</CabinetCachePath>
  </PropertyGroup>

  <!-- A change of any of these publishes the program, or lays the application out, again. -->
  <ItemGroup>
    <BuildRuleFile Include="$(RepositoryRoot)Directory.Build.props;$(RepositoryRoot)Directory.Build.targets;$(RepositoryRoot)Directory.Packages.props" />
    <BuildRuleFile Include="$(MSBuildThisFileFullPath);$(MSBuildProjectFullPath)" />
    <SetupInput Include="$(RepositoryRoot)src\Bravo.Setup\**" />
    <SetupInput Include="@(BuildRuleFile)" />
    <WebStaticFile Include="$(RepositoryRoot)web\wwwroot\**" Exclude="$(RepositoryRoot)web\wwwroot\js\**;$(RepositoryRoot)web\wwwroot\css\**" />
    <WebBundleFile Include="$(WebBundleDir)**" />
    <StageInput Include="$(RepositoryRoot)src\**" Exclude="$(RepositoryRoot)src\Bravo.Setup\**" />
    <StageInput Include="@(BuildRuleFile);@(WebStaticFile);@(WebBundleFile)" />
  </ItemGroup>

  <Target Name="PublishSetupProgram" BeforeTargets="BeforeBuild" Inputs="@(SetupInput)" Outputs="$(SetupStamp)">
    <RemoveDir Directories="$(SetupPublishDir)" />
    <Exec Command="&quot;$(DotNetHost)&quot; publish &quot;$(RepositoryRoot)src\Bravo.Setup\Bravo.Setup.csproj&quot; $(StagePublishArguments) $(SetupPublishArguments) -o &quot;$(SetupPublishDir.TrimEnd('\'))&quot;" />
    <Touch Files="$(SetupStamp)" AlwaysCreate="true" />
  </Target>

  <Target Name="StageApplication" BeforeTargets="BeforeBuild" Inputs="@(StageInput)" Outputs="$(StageStamp)">
    <Error Condition="!Exists('$(WebBundleDir)js\main.js') Or !Exists('$(WebBundleDir)css\main.css')"
           Text="The release bundle of the user interface is not in $(WebBundleDir). In web/, run &quot;npm ci&quot; and &quot;npm run build:Release&quot;." />

    <RemoveDir Directories="$(StageDir)" />
    <Exec Command="&quot;$(DotNetHost)&quot; publish &quot;$(RepositoryRoot)src\Bravo.Desktop\Bravo.Desktop.csproj&quot; $(StagePublishArguments) $(ApplicationPublishArguments) -o &quot;$(StageDir.TrimEnd('\'))&quot;" />

    <Copy SourceFiles="@(WebStaticFile)" DestinationFiles="@(WebStaticFile->'$(StageDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
    <Copy SourceFiles="@(WebBundleFile)" DestinationFiles="@(WebBundleFile->'$(StageDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />

    <Touch Files="$(StageStamp)" AlwaysCreate="true" />
  </Target>

</Project>
