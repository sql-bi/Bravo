<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    One source for the two packages: the build defines Scope as perMachine or perUser. Every name here that an
    installation or a deployment of 1.0.x relies on is the one of 1.0.x: the UpgradeCode, the public
    properties, the registry values, the folders, the names of the product.
  -->
  <?define RegistryKey = "Software\SQLBI\Bravo" ?>

  <?if $(Scope) = perMachine ?>
    <?define ProductName = "!(loc.ProductName)" ?>
    <?define RegistryRoot = "HKLM" ?>
    <?define ProgramFilesDirectory = "ProgramFiles64Folder" ?>
  <?elseif $(Scope) = perUser ?>
    <?define ProductName = "!(loc.ProductName) (User)" ?>
    <?define RegistryRoot = "HKCU" ?>
    <?define ProgramFilesDirectory = "ProgramFilesFolder" ?>
  <?else?>
    <?error Scope is perMachine or perUser ?>
  <?endif?>

  <!-- The version of the product is the version of the file of the application, as in 1.0.x. -->
  <Package Name="$(ProductName)"
           Manufacturer="SQLBI"
           Version="!(bind.fileVersion.BravoExe)"
           UpgradeCode="{888BDB48-B16A-4D9A-8FE6-0206897B1162}"
           Scope="$(Scope)"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Compressed="yes">

    <SummaryInformation Description="!(loc.PackageDescription)" Manufacturer="SQLBI" />

    <!--
      A package replaces an installed one of its installation context, of a lower version or of its own: a
      preview is replaced by its release. The installed one is removed before the new files are copied.
    -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  IgnoreLanguage="yes"
                  DowngradeErrorMessage="!(loc.MajorUpgradeDowngradeErrorMessage)"
                  Schedule="afterInstallValidate" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <?if $(Scope) = perUser ?>
      <!-- Per user by default and with no elevation, as 1.0.x: its files go under the Programs folder of the user. -->
      <Property Id="ALLUSERS" Value="2" />
      <Property Id="MSIINSTALLPERUSER" Value="1" />
    <?endif?>

    <!--
      The oldest Windows that both .NET 10 and the WebView2 runtime support: Windows 10 version 1607 and
      Windows Server 2016, build 14393. VersionNT does not tell Windows 10 from Windows 8.1.
    -->
    <Property Id="WINDOWSBUILDNUMBER" Secure="yes">
      <RegistrySearch Id="BuildNumberSearch" Root="HKLM" Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion" Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR WINDOWSBUILDNUMBER &gt;= 14393" Message="!(loc.SupportedWindowsVersionConditionMessage)" />

    <Icon Id="app.ico" SourceFile="!(bindpath.ApplicationAssets)\bravo.ico" />
    <Property Id="ARPPRODUCTICON" Value="app.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/sql-bi/bravo" />
    <Property Id="ARPNOREPAIR" Value="yes" />

    <!--
      The choices of who installs. A value of 1 on the command line turns a choice on and any other value turns
      it off. With no value, a first installation turns it on, and an upgrade or a removal reads what the
      installed package wrote in the registry.
    -->
    <Property Id="DESKTOPSHORTCUTENABLED" Secure="yes" />
    <Property Id="PROGRAMMENUSHORTCUTENABLED" Secure="yes" />
    <Property Id="INSTALLERTELEMETRYENABLED" Secure="yes" />
    <Property Id="APPLICATIONTELEMETRYENABLED" Secure="yes" />

    <!-- Accepted and not read, as in 1.0.x: the identifier is always computed from who installs. -->
    <Property Id="TELEMETRYUSERID" Secure="yes" />

    <Property Id="DESKTOPSHORTCUTENABLEDREMEMBER">
      <RegistrySearch Id="searchDesktopShortcutEnabledRemember" Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="desktopShortcutEnabled" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="PROGRAMMENUSHORTCUTENABLEDREMEMBER">
      <RegistrySearch Id="searchProgramMenuShortcutEnabledRemember" Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="programMenuShortcutEnabled" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="INSTALLERTELEMETRYENABLEDREMEMBER">
      <RegistrySearch Id="searchInstallerTelemetryEnabledRemember" Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="installerTelemetryEnabled" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="APPLICATIONTELEMETRYENABLEDREMEMBER">
      <RegistrySearch Id="searchApplicationTelemetryEnabledRemember" Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="applicationTelemetryEnabled" Type="raw" Bitness="always64" />
    </Property>

    <?foreach Choice in DESKTOPSHORTCUTENABLED;PROGRAMMENUSHORTCUTENABLED;INSTALLERTELEMETRYENABLED;APPLICATIONTELEMETRYENABLED ?>
      <SetProperty Action="Default$(Choice)" Id="$(Choice)" Value="1" After="AppSearch" Sequence="first"
                   Condition="NOT $(Choice) AND ((NOT Installed AND NOT WIX_UPGRADE_DETECTED) OR $(Choice)REMEMBER = &quot;1&quot;)" />
      <!-- A property without a value is a check box that is not checked. -->
      <SetProperty Action="Undefine$(Choice)" Id="$(Choice)" Value="{}" After="Default$(Choice)" Sequence="first"
                   Condition="$(Choice) AND $(Choice) &lt;&gt; &quot;1&quot;" />
    <?endforeach?>

    <StandardDirectory Id="$(ProgramFilesDirectory)">
      <Directory Id="AppManufacturer" Name="SQLBI">
        <Directory Id="INSTALLFOLDER" Name="Bravo" />
      </Directory>
    </StandardDirectory>

    <?if $(Scope) = perMachine ?>
      <!--
        Where Power BI Desktop reads the external tools: under the 32-bit Common Files, which needs
        administrator rights. The package installs nothing there: the program writes the file and removes it.
      -->
      <StandardDirectory Id="CommonFilesFolder">
        <Directory Id="MicrosoftShared" Name="Microsoft Shared">
          <Directory Id="PowerBIDesktop" Name="Power BI Desktop">
            <Directory Id="POWERBIEXTERNALTOOLSFOLDER" Name="External Tools" />
          </Directory>
        </Directory>
      </StandardDirectory>
    <?endif?>

    <Feature Id="Complete" Title="$(ProductName)" Level="1">
      <ComponentGroupRef Id="Application" />
      <ComponentRef Id="DesktopShortcut" />
      <ComponentRef Id="ProgramMenuShortcut" />
    </Feature>

    <!-- The folder of the publish, laid out by Stage.targets. The executable is named: actions refer to it. -->
    <ComponentGroup Id="Application" Directory="INSTALLFOLDER">
      <Component Id="BravoExe">
        <File Id="BravoExe" Source="!(bindpath.Application)\Bravo.exe" KeyPath="yes" />
      </Component>
      <Files Include="!(bindpath.Application)\**">
        <Exclude Files="!(bindpath.Application)\Bravo.exe" />
      </Files>

      <!--
        What the application and a later package read: where the application is, which tells the application
        how it was installed, and the choices of who installed it.
      -->
      <Component Id="InstallationRegistry">
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="installFolder" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="desktopShortcutEnabled" Value="[DESKTOPSHORTCUTENABLED]" Type="string" />
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="programMenuShortcutEnabled" Value="[PROGRAMMENUSHORTCUTENABLED]" Type="string" />
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="installerTelemetryEnabled" Value="[INSTALLERTELEMETRYENABLED]" Type="string" />
        <RegistryValue Root="$(RegistryRoot)" Key="$(RegistryKey)" Name="applicationTelemetryEnabled" Value="[APPLICATIONTELEMETRYENABLED]" Type="string" />
      </Component>
    </ComponentGroup>

    <!-- The two shortcuts are the components of 1.0.x, with their identifiers. -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="{8C035041-08C9-44CB-B254-D66DA096C53D}" Condition="DESKTOPSHORTCUTENABLED = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="$(ProductName)" Target="[INSTALLFOLDER]Bravo.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="$(RegistryKey)" Name="desktopShortcutInstalled" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ProgramMenuShortcut" Guid="{B6EB02B3-E16E-4661-89E4-A46C50815577}" Condition="PROGRAMMENUSHORTCUTENABLED = &quot;1&quot;">
        <Shortcut Id="ProgramMenuShortcut" Name="$(ProductName)" Target="[INSTALLFOLDER]Bravo.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="$(RegistryKey)" Name="programMenuShortcutInstalled" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!--
      What the package asks of Bravo.Setup.CA.dll, the custom action library of src/Bravo.Setup. The package
      holds the library in itself and does not install it: no action loads a file of a folder that somebody
      could have written in. An action reads its data from the property of its own name, which SetProperty sets
      before it. No action fails an installation: its result is ignored, and the library writes in the log of
      Windows Installer why it failed. A value cannot have a semicolon: the action that gets one fails.
    -->
    <Binary Id="SetupLibrary" SourceFile="!(bindpath.Setup)\Bravo.Setup.CA.dll" />

    <?if $(Scope) = perMachine ?>
      <?define ExternalToolData = "ToolFile=[POWERBIEXTERNALTOOLSFOLDER]bravo.pbitool.json;Executable=[#BravoExe]" ?>

      <!--
        With the rights of the installation: the folder of the external tools is not writable by a user. A
        failed installation takes the registration back; a failed upgrade leaves the one of the installed
        version, which names the same file.
      -->
      <SetProperty Id="RegisterExternalTool" Value="$(ExternalToolData)" Before="RegisterExternalTool" Sequence="execute" />
      <CustomAction Id="RegisterExternalTool" BinaryRef="SetupLibrary" DllEntry="RegisterExternalTool" Execute="deferred" Impersonate="no" Return="ignore" />
      <SetProperty Id="RollbackExternalTool" Value="$(ExternalToolData)" Before="RollbackExternalTool" Sequence="execute" />
      <CustomAction Id="RollbackExternalTool" BinaryRef="SetupLibrary" DllEntry="UnregisterExternalTool" Execute="rollback" Impersonate="no" Return="ignore" />
    <?endif?>

    <!--
      What cannot be taken back is done when the installation or the removal has succeeded: a commit action.
      Windows Installer runs no commit action when rollback is disabled, so each one has a deferred twin for
      that case, at the end of the script.

      The events and the removal of the data run as who installs or removes, also in the package per machine:
      the identifier of an event is computed from the account, and the data folder is the one of that user. On a
      server of Remote Desktop, Windows Installer runs such an action of a package per machine as the system
      unless it is TerminalServerAware, as the events are. The library knows the name of the data folder.
    -->
    <?define ReportData = "Scope=$(Scope);ProductName=Bravo;ProductVersion=$(ProductVersion);ProductBuild=!(bind.fileVersion.BravoExe);TelemetryEnabled=[INSTALLERTELEMETRYENABLED]" ?>

    <?foreach Execute in commit;deferred ?>
      <SetProperty Id="ReportInstall.$(Execute)" Value="$(ReportData)" Before="ReportInstall.$(Execute)" Sequence="execute" />
      <CustomAction Id="ReportInstall.$(Execute)" BinaryRef="SetupLibrary" DllEntry="ReportInstall" Execute="$(Execute)" Impersonate="yes" TerminalServerAware="yes" Return="ignore" />
      <?if $(Scope) = perMachine ?>
        <SetProperty Id="UnregisterExternalTool.$(Execute)" Value="$(ExternalToolData)" Before="UnregisterExternalTool.$(Execute)" Sequence="execute" />
        <CustomAction Id="UnregisterExternalTool.$(Execute)" BinaryRef="SetupLibrary" DllEntry="UnregisterExternalTool" Execute="$(Execute)" Impersonate="no" Return="ignore" />
      <?endif?>
      <SetProperty Id="RemoveUserData.$(Execute)" Value="LocalApplicationData=[LocalAppDataFolder]" Before="RemoveUserData.$(Execute)" Sequence="execute" />
      <CustomAction Id="RemoveUserData.$(Execute)" BinaryRef="SetupLibrary" DllEntry="RemoveUserData" Execute="$(Execute)" Impersonate="yes" Return="ignore" />
      <SetProperty Id="ReportUninstall.$(Execute)" Value="$(ReportData)" Before="ReportUninstall.$(Execute)" Sequence="execute" />
      <CustomAction Id="ReportUninstall.$(Execute)" BinaryRef="SetupLibrary" DllEntry="ReportUninstall" Execute="$(Execute)" Impersonate="yes" TerminalServerAware="yes" Return="ignore" />
    <?endforeach?>

    <!--
      An installation, also over an earlier version, registers and reports. A removal that is not part of an
      upgrade takes the registration back, removes the data of the user and reports.
    -->
    <?define WhenInstalling = NOT Installed AND NOT REMOVE ?>
    <?define WhenRemoving = (NOT UPGRADINGPRODUCTCODE) AND (REMOVE="ALL") ?>

    <InstallExecuteSequence>
      <?if $(Scope) = perMachine ?>
        <Custom Action="RollbackExternalTool" Before="RegisterExternalTool" Condition="$(WhenInstalling) AND NOT WIX_UPGRADE_DETECTED" />
        <Custom Action="RegisterExternalTool" After="InstallFiles" Condition="$(WhenInstalling)" />

        <Custom Action="UnregisterExternalTool.commit" Before="UnregisterExternalTool.deferred" Condition="$(WhenRemoving) AND NOT RollbackDisabled" />
        <Custom Action="UnregisterExternalTool.deferred" Before="RemoveUserData.commit" Condition="$(WhenRemoving) AND RollbackDisabled" />
      <?endif?>
      <Custom Action="RemoveUserData.commit" Before="RemoveUserData.deferred" Condition="$(WhenRemoving) AND NOT RollbackDisabled" />
      <Custom Action="RemoveUserData.deferred" Before="ReportUninstall.commit" Condition="$(WhenRemoving) AND RollbackDisabled" />
      <Custom Action="ReportUninstall.commit" Before="ReportUninstall.deferred" Condition="$(WhenRemoving) AND NOT RollbackDisabled" />
      <Custom Action="ReportUninstall.deferred" Before="ReportInstall.commit" Condition="$(WhenRemoving) AND RollbackDisabled" />
      <Custom Action="ReportInstall.commit" Before="ReportInstall.deferred" Condition="$(WhenInstalling) AND NOT RollbackDisabled" />
      <Custom Action="ReportInstall.deferred" Before="InstallFinalize" Condition="$(WhenInstalling) AND RollbackDisabled" />
    </InstallExecuteSequence>

    <!-- The dialogs: the installation folder set of WiX, with the choices of the shortcuts and of telemetry. -->
    <ui:WixUI Id="BravoUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UIRef Id="WixUI_ErrorProgressText" />
    <WixVariable Id="WixUIDialogBmp" Value="assets\background.png" />
    <WixVariable Id="WixUIBannerBmp" Value="assets\banner.png" />
    <WixVariable Id="WixUILicenseRtf" Value="assets\license.rtf" />

    <!-- The last dialog offers to start the application, as who installs and without waiting for it. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApplicationCheckBoxText) $(ProductName)" />
    <CustomAction Id="LaunchApplication" FileRef="BravoExe" ExeCommand="" Return="asyncNoWait" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

  </Package>

</Wix>
