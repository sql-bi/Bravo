<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- The declarations that CsWin32 generates from NativeMethods.txt use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    CsWin32 declares the functions of Windows that only a test calls: the ones that write the Internet settings
    of the user, on a runner. The functions that the application calls are the ones of its own assembly.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bravo.Api\Bravo.Api.csproj" />
    <ProjectReference Include="..\..\src\Bravo.Core\Bravo.Core.csproj" />
    <ProjectReference Include="..\..\src\Bravo.Desktop\Bravo.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Bravo.Platform.Windows\Bravo.Platform.Windows.csproj" />
  </ItemGroup>

  <!-- The proxy of a test, which the tests of the adapters own: one source for both projects. -->
  <ItemGroup>
    <Compile Include="..\Bravo.Platform.Windows.Tests\Network\TestProxy.cs" Link="Network\TestProxy.cs" />
    <Compile Include="..\Bravo.Platform.Windows.Tests\Network\TestProxyRequest.cs" Link="Network\TestProxyRequest.cs" />
  </ItemGroup>

  <!--
    The process tests start the executable in the output folder of its own project, where all that it loads is
    beside it: the folder of the tests holds only what the tests reference. They find it through this file.
  -->
  <Target Name="WriteExecutablePath" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <DesktopAssembly Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferencePath.Filename)' == 'Bravo'" />
      <FileWrites Include="$(OutDir)BravoExecutable.txt" />
    </ItemGroup>
    <WriteLinesToFile File="$(OutDir)BravoExecutable.txt" Lines="@(DesktopAssembly->'%(RootDir)%(Directory)Bravo.exe')" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
