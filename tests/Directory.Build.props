<Project>

  <!-- MSBuild stops at the first Directory.Build.props it finds: the rules of the root file are imported here. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- An xUnit v3 test project is an executable, which dotnet test runs on Microsoft.Testing.Platform. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

</Project>
