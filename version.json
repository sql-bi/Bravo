{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "1.1.0-beta.1",
  "assemblyVersion": {
    "precision": "minor"
  },
  "nuGetPackageVersion": {
    "semVer": 2,
    "precision": "build"
  },
  "pathFilters": [
    ":/"
  ],
  "publicReleaseRefSpec": [
    "^refs/heads/main$"
  ],
  "cloudBuild": {
    "buildNumber": {
      "enabled": true
    }
  }
}
