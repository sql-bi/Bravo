<Project Sdk="Microsoft.NET.Sdk">

  <!-- The executable is Bravo.exe, the name that users and the external tool registration of 1.0.x know. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Bravo</AssemblyName>
    <ApplicationIcon>Assets\bravo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The icon of the executable is also the icon of the main window, which reads it from the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\bravo.ico" LogicalName="Bravo.ico" />
  </ItemGroup>

  <!-- Windows Forms. ApplicationConfiguration.Initialize is generated from these properties. -->
  <PropertyGroup>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <!--
    A build is a development build unless the release pipeline builds it, with -p:BravoReleaseBuild=true. The
    property is not the configuration: a Release configuration built on a developer's machine is a development
    build. The application reads what was built from this metadata: see BuildIdentity.cs.
  -->
  <ItemGroup>
    <AssemblyMetadata Include="BravoReleaseBuild" Value="$(BravoReleaseBuild)" Condition="'$(BravoReleaseBuild)' == 'true'" />
  </ItemGroup>

  <!--
    The user interface beside the executable. The build never runs npm: a development build copies web/wwwroot
    as it is, with the development bundle when "npm run build:UI" has written it there. A release build copies
    nothing: the release assembles the folder from the release bundle (backlog D-01).
  -->
  <ItemGroup Condition="'$(BravoReleaseBuild)' != 'true'">
    <None Include="..\..\web\wwwroot\**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- The declarations that CsWin32 generates from NativeMethods.txt use pointers. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- The second name is the assembly where NSubstitute generates the substitutes of internal interfaces. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Bravo.Desktop.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <!-- ASP.NET Core, which brings the host and the server of the API, is a shared framework of the runtime. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Bravo.Api\Bravo.Api.csproj" />
    <ProjectReference Include="..\Bravo.Core\Bravo.Core.csproj" />
    <ProjectReference Include="..\Bravo.Platform.Windows\Bravo.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
