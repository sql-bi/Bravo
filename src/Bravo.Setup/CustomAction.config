<?xml version="1.0" encoding="utf-8"?>
<!--
  The configuration of the application domain where DTF runs an action. Without a runtime, DTF would choose the
  one that its own assembly was built for, .NET Framework 2.0. The runtime names no sku: an older 4.x runs the
  library rather than refuse it (ADR 0029). DTF asks for the runtime through the legacy activation of the CLR,
  which .NET Framework 4 limits to version 2.0 unless the policy of version 2.0 is chosen: without it, no
  runtime loads and every action fails.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
