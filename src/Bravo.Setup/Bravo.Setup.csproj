<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The custom action library that the installer packages run (ADR 0029), on the .NET Framework of 1.0.x. The
    build packs it with the stub of DTF into Bravo.Setup.CA.dll, the file that a package holds. C# is the
    version of .NET Framework, 7.3, which has no nullable reference types.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!--
    Only the build of the packages, with -p:BravoReleaseBuild=true, sends the events of the installer: the
    constant chooses what the library composes, without reflection. Any other build, the one of the tests
    included, sends nothing.
  -->
  <PropertyGroup Condition="'$(BravoReleaseBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);BRAVO_RELEASE_BUILD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Dtf.CustomAction" PrivateAssets="all" />
    <PackageReference Include="WixToolset.Dtf.WindowsInstaller" />
  </ItemGroup>

  <!-- The runtime that the library asks of Windows Installer: DTF packs this file with it. -->
  <ItemGroup>
    <Content Include="CustomAction.config" />
  </ItemGroup>

  <!-- The icon of the external tool registration, the image that 1.0.x registers. -->
  <ItemGroup>
    <EmbeddedResource Include="ExternalTools\ExternalToolIcon.ico" LogicalName="Bravo.Setup.ExternalToolIcon.ico" />
  </ItemGroup>

  <!-- The second name is the assembly where NSubstitute generates the substitutes of internal interfaces. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Bravo.Setup.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
