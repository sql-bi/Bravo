{
  "openapi": "3.1.1",
  "info": {
    "title": "Bravo for Power BI",
    "description": "The API of the host, which the user interface calls on the loopback address.",
    "version": "unversioned"
  },
  "paths": {
    "/application": {
      "get": {
        "tags": [
          "Application"
        ],
        "summary": "Reads what the application is: its version, the culture of the user and the kind of its build.",
        "operationId": "GetApplication",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationDetails"
                }
              }
            }
          }
        }
      }
    },
    "/options": {
      "get": {
        "tags": [
          "Options"
        ],
        "summary": "Reads the options of the user.",
        "operationId": "GetOptions",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOptions"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Options"
        ],
        "summary": "Replaces the options of the user, and returns them as they were kept. When they cannot be kept, the ones before stay.",
        "operationId": "UpdateOptions",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserOptions"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOptions"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/policies": {
      "get": {
        "tags": [
          "Policies"
        ],
        "summary": "Reads the policies that an administrator set for the application. They apply over the options of the user, which keep the choices of the user, and do not change while the application runs.",
        "operationId": "GetPolicies",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyDetails"
                }
              }
            }
          }
        }
      }
    },
    "/events": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "Reads the events of the host after a number, waiting for the next one when there is none.",
        "operationId": "GetEvents",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "The number of the last event already read. Without it, the answer has every event still kept.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventBatch"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/log": {
      "get": {
        "tags": [
          "Log"
        ],
        "summary": "Reads the records of the log of the host after a number, among the last ones that it keeps.",
        "operationId": "GetLog",
        "parameters": [
          {
            "name": "after",
            "in": "query",
            "description": "The number of the last record already read. Without it, the answer has every record still kept.",
            "schema": {
              "maximum": 2147483647,
              "minimum": 0,
              "type": "integer",
              "format": "int32",
              "default": 0
            }
          }
        ],
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogBatch"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/network/proxy-credentials/prompt": {
      "post": {
        "tags": [
          "Network"
        ],
        "summary": "Asks the user for the credentials of the proxy server in a dialog of Windows, and keeps what the user enters in the Windows Credential Manager. It answers when the user has closed the dialog.",
        "operationId": "PromptProxyCredentials",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyCredentialsPromptResult"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/network/proxy-credentials": {
      "delete": {
        "tags": [
          "Network"
        ],
        "summary": "Forgets the credentials of the proxy server that the user entered. With none kept it does nothing.",
        "operationId": "DeleteProxyCredentials",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/releases/latest": {
      "get": {
        "tags": [
          "Releases"
        ],
        "summary": "Reads the latest release from the update feed: whether it is newer than the application, and the address of its file for this copy. The host also tells a newer release with the beep of the system. When a policy turned the update check off, nothing is read and the answer is the error UpdateCheckDisabled.",
        "operationId": "GetLatestRelease",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LatestRelease"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/browser/open": {
      "post": {
        "tags": [
          "Browser"
        ],
        "summary": "Opens a page in the default browser of the user: only a page on a site that the application trusts.",
        "operationId": "OpenInBrowser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OpenInBrowserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/telemetry": {
      "get": {
        "tags": [
          "Telemetry"
        ],
        "summary": "Reads where the page sends its telemetry and what its items carry. Whether it sends it is the option of the user, or the policy of an administrator.",
        "operationId": "GetTelemetry",
        "responses": {
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ActivationEvent": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "serverName": {
            "type": "string"
          },
          "databaseName": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What was wrong in the command line, in English. Empty for a start with no error."
          }
        },
        "description": "What a start of the application asked for on its command line."
      },
      "ApplicationCulture": {
        "required": [
          "ietfLanguageTag",
          "twoLetterISOLanguageName"
        ],
        "type": "object",
        "properties": {
          "ietfLanguageTag": {
            "type": "string",
            "description": "The language tag of the culture, such as `en-US`."
          },
          "twoLetterISOLanguageName": {
            "type": "string",
            "description": "The two letters of the language of the culture, such as `en`."
          }
        },
        "description": "The culture of the user, by which the user interface chooses its language and its formats."
      },
      "ApplicationDetails": {
        "required": [
          "version",
          "culture",
          "isDevelopmentBuild"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The version of the application as a user reads it, such as `1.1.0` or `1.1.0-beta.1`."
          },
          "culture": {
            "$ref": "#/components/schemas/ApplicationCulture"
          },
          "isDevelopmentBuild": {
            "type": "boolean",
            "description": "Whether the build is a development build, and not one of the release pipeline."
          }
        },
        "description": "What the running application is. The values do not change while the application runs."
      },
      "DiagnosticLevel": {
        "enum": [
          "None",
          "Basic",
          "Verbose"
        ],
        "type": "string",
        "description": "How much the diagnostics pane of the user interface shows."
      },
      "EventBatch": {
        "required": [
          "events",
          "next"
        ],
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HostEvent"
            },
            "description": "The events after the number of the request, oldest first. Empty when none arrived within the limit. When the first number is not the one that follows the number of the request, the events between the two are no longer kept."
          },
          "next": {
            "type": "integer",
            "description": "The number to send with the next request: the one of the last event of the host.",
            "format": "int32"
          }
        },
        "description": "The answer to a request for the events after a number."
      },
      "HostEvent": {
        "required": [
          "number",
          "kind"
        ],
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "description": "The position of the event among the events of this process: the first is 1, and none is skipped.",
            "format": "int32"
          },
          "kind": {
            "$ref": "#/components/schemas/HostEventKind"
          },
          "activation": {
            "description": "Present when `kind` is `Activation`.",
            "$ref": "#/components/schemas/ActivationEvent"
          }
        },
        "description": "Something that happened in the host and that the user interface is told about. One type for every kind of event: `kind` names the kind, and the member with the data of that kind is the one present."
      },
      "HostEventKind": {
        "enum": [
          "Activation",
          "SettingsReadFailed"
        ],
        "type": "string"
      },
      "HttpValidationProblemDetails": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "traceId": {
            "type": "string",
            "description": "The identifier of the request in the log of the host."
          }
        }
      },
      "LatestRelease": {
        "required": [
          "version",
          "isNewer",
          "downloadAddress",
          "releaseNotesAddress"
        ],
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "description": "The version of the release as a user reads it, such as `1.1.0`."
          },
          "isNewer": {
            "type": "boolean",
            "description": "Whether the release is newer than the application that answers."
          },
          "downloadAddress": {
            "type": "string",
            "description": "The address of the file of the release for this copy of the application: the package of its kind, or the archive for a copy that no package installed. Absolute, with every character that an address cannot hold escaped."
          },
          "releaseNotesAddress": {
            "type": "string",
            "description": "The address of the page that tells what the release changes. Absolute, with every character that an address cannot hold escaped."
          }
        },
        "description": "The latest release of the application, as the update feed names it, for the copy of the application that answers."
      },
      "LogBatch": {
        "required": [
          "records",
          "next"
        ],
        "type": "object",
        "properties": {
          "records": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LogRecord"
            },
            "description": "The records after the number of the request, oldest first. When the first number is not the one that follows the number of the request, the records between the two are no longer kept."
          },
          "next": {
            "type": "integer",
            "description": "The number to send with the next request: the one of the last record of the host.",
            "format": "int32"
          }
        },
        "description": "The answer to a request for the records of the log after a number."
      },
      "LogRecord": {
        "required": [
          "number",
          "time",
          "level",
          "category",
          "eventId",
          "message"
        ],
        "type": "object",
        "properties": {
          "number": {
            "type": "integer",
            "description": "The number of the record, in the order that the host wrote them: the first of each process is 1.",
            "format": "int32"
          },
          "time": {
            "type": "string",
            "description": "When the host wrote the record, in UTC.",
            "format": "date-time"
          },
          "level": {
            "description": "How serious what the record tells is.",
            "$ref": "#/components/schemas/LogRecordLevel"
          },
          "category": {
            "type": "string",
            "description": "What wrote the record: the full name of a type of the host or of a library."
          },
          "eventId": {
            "type": "integer",
            "description": "What happened, as the number that the category gives it, or 0.",
            "format": "int32"
          },
          "eventName": {
            "type": "string",
            "description": "What happened, as the name that the category gives it."
          },
          "message": {
            "type": "string",
            "description": "What happened, in English."
          },
          "traceId": {
            "type": "string",
            "description": "The trace of the work that the record belongs to, as 32 hexadecimal digits: for a request, the middle part of the traceId of its error answer."
          },
          "exception": {
            "type": "string",
            "description": "The exception that the record tells of, with its causes and where each one was thrown."
          }
        },
        "description": "What the host recorded, of its own work or of a library that it uses."
      },
      "LogRecordLevel": {
        "enum": [
          "Trace",
          "Debug",
          "Information",
          "Warning",
          "Error",
          "Critical"
        ],
        "type": "string",
        "description": "How serious what a record tells is, from the least to the most."
      },
      "OpenInBrowserRequest": {
        "required": [
          "address"
        ],
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "description": "The address of the page: absolute, with the scheme `https` or `http`, on a site that the application trusts.",
            "format": "uri"
          }
        },
        "description": "The page to open in the default browser of the user."
      },
      "PolicyDetails": {
        "type": "object",
        "properties": {
          "telemetryEnabled": {
            "type": "boolean"
          },
          "updateCheckEnabled": {
            "type": "boolean",
            "description": "With `false` the host makes no request to the update feed: `GET /releases/latest` answers the error `UpdateCheckDisabled`."
          },
          "useSystemBrowserForAuthentication": {
            "type": "boolean"
          },
          "builtInTemplatesEnabled": {
            "type": "boolean"
          },
          "customTemplatesEnabled": {
            "type": "boolean"
          },
          "customTemplatesOrganizationRepositoryPath": {
            "type": "string",
            "description": "The folder of the templates of the organization, as the administrator wrote it."
          }
        },
        "description": "The policies that an administrator set for the application, read when it started. A member that is absent is a policy that is not configured: the option of the user applies. A member that is present is the value of the option, which the user cannot change."
      },
      "ProblemCode": {
        "enum": [
          "InvalidRequest",
          "ValidationFailed",
          "Unauthorized",
          "NotFound",
          "MethodNotAllowed",
          "UnsupportedMediaType",
          "Unexpected",
          "HttpError",
          "UpdateCheckFailed",
          "SettingsSaveFailed",
          "UpdateCheckDisabled",
          "ProxyAuthenticationRequired",
          "ProxyConnectionRefused",
          "ServerUnreachable",
          "SecureConnectionFailed",
          "ProxyCredentialsStoreFailed"
        ],
        "type": "string",
        "description": "What went wrong, as a name that never changes meaning. No error answer has a code outside this list."
      },
      "ProblemDetails": {
        "required": [
          "code"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "traceId": {
            "type": "string",
            "description": "The identifier of the request in the log of the host."
          }
        }
      },
      "ProxyCredentialsPromptResult": {
        "required": [
          "entered"
        ],
        "type": "object",
        "properties": {
          "entered": {
            "type": "boolean",
            "description": "Whether the user entered credentials, which the application keeps and answers a proxy server with from now on. False when the user cancelled the dialog, or the application has no window to show it in: the credentials that were kept, if any, stay as they were."
          }
        },
        "description": "What the user did in the dialog that asks for the credentials of the proxy server."
      },
      "ProxyOptions": {
        "required": [
          "type",
          "useDefaultCredentials",
          "bypassOnLocal"
        ],
        "type": "object",
        "properties": {
          "type": {
            "$ref": "#/components/schemas/ProxyType"
          },
          "useDefaultCredentials": {
            "type": "boolean"
          },
          "address": {
            "type": "string",
            "description": "The address of the proxy server, with or without `http://`. Empty means none."
          },
          "bypassOnLocal": {
            "type": "boolean"
          },
          "bypassList": {
            "type": "string",
            "description": "The addresses that do not go through the proxy server: regular expressions separated by semicolons. Empty means none."
          }
        }
      },
      "ProxyType": {
        "enum": [
          "None",
          "System",
          "Custom"
        ],
        "type": "string"
      },
      "TelemetryDetails": {
        "required": [
          "userId",
          "sessionId",
          "version",
          "properties"
        ],
        "type": "object",
        "properties": {
          "connectionString": {
            "type": "string",
            "description": "The connection string of Application Insights, with no slash at the end of its ingestion endpoint. Absent for a build that sends nothing, such as a development build started without an endpoint."
          },
          "userId": {
            "type": "string",
            "description": "The identifier of the user on the computer, which tells neither name."
          },
          "sessionId": {
            "type": "string",
            "description": "The identifier of the run of the application, the same for the host and the page."
          },
          "version": {
            "type": "string",
            "description": "The version of the application as a user reads it, such as `1.1.0` or `1.1.0-beta.1`."
          },
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "The properties that every item carries, by their names."
          }
        },
        "description": "What the page needs to send its telemetry, with the values of the telemetry of the host. The page sends it only when the user or a policy turned it on. The values do not change while the application runs."
      },
      "Theme": {
        "enum": [
          "Auto",
          "Light",
          "Dark"
        ],
        "type": "string"
      },
      "UserOptions": {
        "required": [
          "theme",
          "telemetryEnabled",
          "customTemplatesEnabled",
          "updateCheckEnabled",
          "useSystemBrowserForAuthentication",
          "diagnosticLevel",
          "proxy"
        ],
        "type": "object",
        "properties": {
          "theme": {
            "$ref": "#/components/schemas/Theme"
          },
          "telemetryEnabled": {
            "type": "boolean"
          },
          "customTemplatesEnabled": {
            "type": "boolean"
          },
          "updateCheckEnabled": {
            "type": "boolean"
          },
          "useSystemBrowserForAuthentication": {
            "type": "boolean"
          },
          "diagnosticLevel": {
            "$ref": "#/components/schemas/DiagnosticLevel"
          },
          "proxy": {
            "$ref": "#/components/schemas/ProxyOptions"
          },
          "customOptions": {
            "description": "The options that only the user interface reads: any JSON value, returned as it was sent."
          }
        },
        "description": "The options of the user, as the user interface reads them and replaces them."
      }
    }
  },
