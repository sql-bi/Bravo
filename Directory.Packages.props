<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version set here also applies where the package arrives as a dependency of another one. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers of every project. The banned symbols are in BannedSymbols.txt. -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!--
    Tests: xUnit v3 on Microsoft.Testing.Platform, the mode of dotnet test that global.json selects. In that
    mode no project needs the Visual Studio runner or Microsoft.NET.Test.Sdk.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!--
    Packages of the .NET release train, in the version of the .NET 10 runtime: logging, and the reader of
    assemblies as metadata of the architecture tests.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />
  </ItemGroup>

  <!-- Generates the declarations of the Windows functions that the NativeMethods.txt of a project lists. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
  </ItemGroup>

</Project>
