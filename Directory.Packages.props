<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- A version set here also applies where the package arrives as a dependency of another one. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Analyzers of every project. The banned symbols are in BannedSymbols.txt. -->
  <ItemGroup>
    <GlobalPackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <!--
    The version of every build, computed from version.json and from the history of git: a build needs the whole
    history, and fails on a shallow clone.
  -->
  <ItemGroup>
    <GlobalPackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" />
  </ItemGroup>

  <!--
    Tests: xUnit v3 on Microsoft.Testing.Platform, the mode of dotnet test that global.json selects. In that
    mode no project needs the Visual Studio runner or Microsoft.NET.Test.Sdk.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="11.0.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="NSubstitute.Analyzers.CSharp" Version="1.0.17" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <!--
    Packages of the .NET release train, in the version of the .NET 10 runtime: the OpenAPI document of the API,
    the server that its tests run on, logging, the command line, and the reader of assemblies as metadata of the
    architecture tests. ASP.NET Core and the host are not here: they are a shared framework, which a project
    references.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
    <PackageVersion Include="System.CommandLine" Version="2.0.15" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.15" />
  </ItemGroup>

  <!-- The webview of the main window: the control for Windows Forms and the loader of the WebView2 runtime. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!--
    The telemetry of the host: the classic SDK of Application Insights, with the channel that keeps in a folder
    what it could not send (ADR 0028). Microsoft supports it until 2027-03-31. The test platform brings the
    first package too, in the same version.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.ApplicationInsights" Version="2.23.0" />
    <PackageVersion Include="Microsoft.ApplicationInsights.WindowsServer.TelemetryChannel" Version="2.23.0" />
  </ItemGroup>

  <!-- Generates the declarations of the Windows functions that the NativeMethods.txt of a project lists. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.371" />
  </ItemGroup>

  <!--
    WiX, in the version of the SDK that installer/ names: the dialogs of the installer packages, and DTF, which
    makes Bravo.Setup a custom action library (ADR 0029). The first package of DTF packs the library for
    Windows Installer; the second is the API of an installation that the library calls.
  -->
  <ItemGroup>
    <PackageVersion Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageVersion Include="WixToolset.Dtf.CustomAction" Version="5.0.2" />
    <PackageVersion Include="WixToolset.Dtf.WindowsInstaller" Version="5.0.2" />
  </ItemGroup>

</Project>
